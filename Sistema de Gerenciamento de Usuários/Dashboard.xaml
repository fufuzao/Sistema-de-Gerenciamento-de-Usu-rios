<Window x:Class="Sistema_de_Gerenciamento_de_Usuários.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard" Width="800" Height="600"
        Background="#FF019288" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Loaded="Janela_Loaded">

   

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Molde do CARD de usuário (com os botões do administrador) -->
            <DataTemplate x:Key="CardUsuario">
                <Border Style="{StaticResource Cartao}">
                    <StackPanel VerticalAlignment="Center">

                        <!-- avatar redondo -->
                        <Ellipse Width="52" Height="52">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding ImagemAvatar}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>

                        <TextBlock Text="{Binding NomeCompleto}" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Arroba}" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Email}" Foreground="White" FontSize="12" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- etiquetas (pílulas) de tipo e status -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                            <Border Style="{StaticResource EtiquetaTipo}">
                                <TextBlock Text="{Binding Tipo}" FontSize="11"/>
                            </Border>
                            <Border Style="{StaticResource EtiquetaStatus}">
                                <TextBlock Text="{Binding Status}" FontSize="11"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding TextoUltimoLogin}" Foreground="White" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>

                        <!-- botões: [Editar] [Excluir], ou [Editar] [Desbloquear] se estiver bloqueado -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button Style="{StaticResource BotaoCard}" Click="BtnEditarCard_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource Icone}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Editar"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BotaoExcluirCard}" Click="BtnExcluirCard_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icone}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Excluir"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource BotaoDesbloquearCard}" Click="BtnDesbloquearCard_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE785;" Style="{StaticResource Icone}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Desbloquear"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Width="780" Height="565" HorizontalAlignment="Center" VerticalAlignment="Center">

        <!-- ============================ BARRA LATERAL ============================ -->
        <Border Width="141" HorizontalAlignment="Left" BorderBrush="{StaticResource CorDivisoria}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,8,0,8">

                <!-- Bloco do usuário logado (embaixo). Clicar abre "Meu perfil". -->
                <Button x:Name="btnBlocoUsuario" DockPanel.Dock="Bottom" Style="{StaticResource BlocoUsuario}"
                        Width="129" ToolTip="Abrir meu perfil" Click="BtnBlocoUsuario_Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="elpAvatarLogado" Width="36" Height="36" Fill="#FF004D40"/>
                            <StackPanel Width="70" Margin="7,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="txtNomeLogado" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="txtTipoLogado" Foreground="White" FontSize="11" Opacity="0.85"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="txtArrobaLogado" Foreground="White" FontSize="10" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="txtNivelLogado" Foreground="White" FontSize="10" Opacity="0.85"/>
                        <TextBlock x:Name="txtUltimoLoginLogado" Foreground="White" FontSize="10" Opacity="0.85"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>

                <!-- Botões do menu (em cima) -->
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                    <Button x:Name="btnMenuUsuarios" Content="Usuários" Style="{StaticResource BotaoMenu}" Click="BtnMenuUsuarios_Click"/>
                    <Button x:Name="btnMenuCadastrar" Content="Cadastrar usuário" Style="{StaticResource BotaoMenu}" Click="BtnMenuCadastrar_Click"/>
                    <Button x:Name="btnMenuAuditoria" Content="Auditoria" Style="{StaticResource BotaoMenu}" Click="BtnMenuAuditoria_Click"/>
                    <Button x:Name="btnMenuSenha" Content="Redefinir senha" Style="{StaticResource BotaoMenu}" Click="BtnMenuSenha_Click"/>
                    <Button x:Name="btnMenuSair" Content="Sair" Style="{StaticResource BotaoMenu}" Click="BtnMenuSair_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================ ÁREA DE CONTEÚDO ============================ -->
        <Grid Width="626" Margin="154,0,0,0" HorizontalAlignment="Left">

            <!-- ====================== TELA 1: LISTA DE USUÁRIOS ====================== -->
            <Grid x:Name="gridUsuarios">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- busca e filtros -->
                    <RowDefinition Height="Auto"/>   <!-- contador -->
                    <RowDefinition Height="*"/>      <!-- cards -->
                    <RowDefinition Height="Auto"/>   <!-- páginas -->
                </Grid.RowDefinitions>

                <!-- Linha de cima: busca + Perfil + Status -->
                <Grid Grid.Row="0" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="128"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="133"/>
                    </Grid.ColumnDefinitions>

                    <!-- caixa de busca com lupa (E721) e texto de dica por cima -->
                    <Grid Grid.Column="0">
                        <TextBox x:Name="txtBusca" Style="{StaticResource CampoTexto}" Height="38" Padding="34,0,10,0"
                                 TextChanged="TxtBusca_TextChanged"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icone}" Foreground="White" FontSize="14"
                                   Margin="13,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                        <TextBlock x:Name="txtDicaBusca" Text="Buscar por nome, usuário ou e-mail" Foreground="White"
                                   Opacity="0.85" FontSize="13" Margin="37,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <ComboBox x:Name="cmbPerfil" Grid.Column="2" Height="38" Tag="Perfil: " SelectedIndex="0"
                              SelectionChanged="CmbFiltro_SelectionChanged">
                        <ComboBoxItem Content="Todos"/>
                        <ComboBoxItem Content="Administrador"/>
                        <ComboBoxItem Content="Comum"/>
                    </ComboBox>

                    <ComboBox x:Name="cmbStatus" Grid.Column="4" Height="38" Tag="Status: " SelectedIndex="0"
                              SelectionChanged="CmbFiltro_SelectionChanged">
                        <ComboBoxItem Content="Todos"/>
                        <ComboBoxItem Content="Ativo"/>
                        <ComboBoxItem Content="Inativo"/>
                        <ComboBoxItem Content="Bloqueado"/>
                    </ComboBox>
                </Grid>

                <!-- contador ("4 usuários") e aviso de sucesso/erro das ações dos cards -->
                <Grid Grid.Row="1" Margin="0,10,0,6">
                    <TextBlock x:Name="txtContador" Text="0 usuários" Foreground="White" FontSize="12" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="txtAvisoLista" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" MaxWidth="480"/>
                </Grid>

                <!-- os cards: grade de 2 colunas x 2 linhas = 4 por página -->
                <ItemsControl x:Name="icCards" Grid.Row="2" Margin="-5" ItemTemplate="{StaticResource CardUsuario}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock x:Name="txtSemResultados" Grid.Row="2" Text="Nenhum usuário encontrado."
                           Foreground="White" FontSize="14" Opacity="0.85"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                <!-- páginas: "<" 1 2 3 ">" -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,8">
                    <Button x:Name="btnAnterior" Content="&lt;" Style="{StaticResource BotaoPagina}" Click="BtnAnterior_Click"/>
                    <StackPanel x:Name="pnlPaginas" Orientation="Horizontal"/>
                    <Button x:Name="btnProxima" Content="&gt;" Style="{StaticResource BotaoPagina}" Click="BtnProxima_Click"/>
                </StackPanel>
            </Grid>

            <!-- ====================== TELA 2: CADASTRAR USUÁRIO ====================== -->
            <Grid x:Name="gridCadastro" Visibility="Collapsed">
                <Border Background="{StaticResource CorCartao}" CornerRadius="14" Padding="22,16" Margin="0,8,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="3">
                            <TextBlock Text="Cadastrar usuário" Style="{StaticResource Titulo}"/>
                            <TextBlock Text="Todos os campos são obrigatórios. A senha é guardada criptografada (hash BCrypt)."
                                       Style="{StaticResource Subtitulo}"/>
                        </StackPanel>

                        <!-- esquerda: dados e senha -->
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Nome completo" Style="{StaticResource Rotulo}"/>
                            <TextBox x:Name="txtNomeCadastro" Style="{StaticResource CampoTexto}"/>

                            <TextBlock Text="Nome de usuário" Style="{StaticResource Rotulo}"/>
                            <TextBox x:Name="txtUsuarioCadastro" Style="{StaticResource CampoTexto}"/>

                            <TextBlock Text="E-mail" Style="{StaticResource Rotulo}"/>
                            <TextBox x:Name="txtEmailCadastro" Style="{StaticResource CampoTexto}"/>

                            <TextBlock Text="Senha (mínimo 8 caracteres)" Style="{StaticResource Rotulo}"/>
                            <PasswordBox x:Name="pwdSenhaCadastro" Style="{StaticResource CampoSenha}"/>

                            <TextBlock Text="Confirmação da senha" Style="{StaticResource Rotulo}"/>
                            <PasswordBox x:Name="pwdConfirmacaoCadastro" Style="{StaticResource CampoSenha}"/>
                        </StackPanel>

                        <!-- direita: tipo, status, avatar e botões -->
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="Tipo de usuário" Style="{StaticResource Rotulo}"/>
                            <ComboBox x:Name="cmbTipoCadastro" SelectedIndex="1">
                                <ComboBoxItem Content="Administrador"/>
                                <ComboBoxItem Content="Comum"/>
                            </ComboBox>

                            <TextBlock Text="Status" Style="{StaticResource Rotulo}"/>
                            <ComboBox x:Name="cmbStatusCadastro" SelectedIndex="0">
                                <ComboBoxItem Content="Ativo"/>
                                <ComboBoxItem Content="Inativo"/>
                            </ComboBox>

                            <TextBlock Text="Imagem de perfil" Style="{StaticResource Rotulo}"/>
                            <ListBox x:Name="lstAvataresCadastro" Style="{StaticResource ListaAvatares}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="btnCadastrar" Content="Cadastrar" Style="{StaticResource BotaoPrincipal}"
                                        Click="BtnCadastrar_Click"/>
                                <Button x:Name="btnLimparCadastro" Content="Limpar" Margin="8,0,0,0"
                                        Click="BtnLimparCadastro_Click"/>
                            </StackPanel>

                            <TextBlock x:Name="txtMensagemCadastro" Style="{StaticResource Mensagem}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ====================== TELA 3: EDITAR USUÁRIO / MEU PERFIL ====================== -->
            <Grid x:Name="gridEdicao" Visibility="Collapsed">
                <Border Background="{StaticResource CorCartao}" CornerRadius="14" Padding="22,16" Margin="0,8,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="3">
                            <TextBlock x:Name="txtTituloEdicao" Text="Editar usuário" Style="{StaticResource Titulo}"/>
                            <TextBlock x:Name="txtInfoEdicao" Style="{StaticResource Subtitulo}"/>
                        </StackPanel>

                        <!-- esquerda: dados (a senha NÃO aparece aqui) -->
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Nome completo" Style="{StaticResource Rotulo}"/>
                            <TextBox x:Name="txtNomeEdicao" Style="{StaticResource CampoTexto}"/>

                            <TextBlock Text="Nome de usuário" Style="{StaticResource Rotulo}"/>
                            <TextBox x:Name="txtUsuarioEdicao" Style="{StaticResource CampoTexto}"/>

                            <TextBlock Text="E-mail" Style="{StaticResource Rotulo}"/>
                            <TextBox x:Name="txtEmailEdicao" Style="{StaticResource CampoTexto}"/>

                            <Border Background="#1AFFFFFF" CornerRadius="8" Padding="10,8" Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" Style="{StaticResource Icone}" Foreground="White" Margin="0,0,8,0"/>
                                    <TextBlock Foreground="White" FontSize="11" TextWrapping="Wrap" Width="230"
                                               Text="A senha não é exibida nem alterada aqui. Use o menu &quot;Redefinir senha&quot;."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- direita: tipo/permissões, status, avatar e botões -->
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="Tipo de usuário (perfil e permissões)" Style="{StaticResource Rotulo}"/>
                            <ComboBox x:Name="cmbTipoEdicao">
                                <ComboBoxItem Content="Administrador"/>
                                <ComboBoxItem Content="Comum"/>
                            </ComboBox>

                            <TextBlock Text="Status" Style="{StaticResource Rotulo}"/>
                            <ComboBox x:Name="cmbStatusEdicao">
                                <ComboBoxItem Content="Ativo"/>
                                <ComboBoxItem Content="Inativo"/>
                                <ComboBoxItem Content="Bloqueado"/>
                            </ComboBox>

                            <TextBlock Text="Imagem de perfil" Style="{StaticResource Rotulo}"/>
                            <ListBox x:Name="lstAvataresEdicao" Style="{StaticResource ListaAvatares}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="btnSalvarEdicao" Content="Salvar alterações" Style="{StaticResource BotaoPrincipal}"
                                        Click="BtnSalvarEdicao_Click"/>
                                <Button x:Name="btnCancelarEdicao" Content="Cancelar" Margin="8,0,0,0"
                                        Click="BtnCancelarEdicao_Click"/>
                            </StackPanel>

                            <TextBlock x:Name="txtMensagemEdicao" Style="{StaticResource Mensagem}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ====================== TELA 4: AUDITORIA ====================== -->
            <Grid x:Name="gridAuditoria" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,8,0,8">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="Auditoria" Style="{StaticResource Titulo}"/>
                        <TextBlock x:Name="txtContadorAuditoria" Style="{StaticResource Subtitulo}" Margin="0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ComboBox x:Name="cmbCategoria" Width="200" Height="38" Tag="Categoria: " SelectedIndex="0"
                                  SelectionChanged="CmbCategoria_SelectionChanged">
                            <ComboBoxItem Content="Todos"/>
                            <ComboBoxItem Content="Alteração"/>
                            <ComboBoxItem Content="Autenticação"/>
                        </ComboBox>
                        <Button x:Name="btnAtualizarAuditoria" Height="38" Margin="8,0,0,0" ToolTip="Atualizar"
                                Click="BtnAtualizarAuditoria_Click">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource Icone}"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <DataGrid x:Name="dgAuditoria" Grid.Row="1" Margin="0,0,0,8"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          CanUserResizeRows="False" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0"
                          Background="Transparent" BorderThickness="0" Foreground="White"
                          RowBackground="#22FFFFFF" AlternatingRowBackground="#11FFFFFF"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          ColumnHeaderStyle="{StaticResource CabecalhoTabela}"
                          CellStyle="{StaticResource CelulaTabela}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data e hora" Binding="{Binding TextoDataHora}" Width="88"
                                            ElementStyle="{StaticResource TextoCelula}"/>
                        <DataGridTextColumn Header="Responsável" Binding="{Binding Responsavel}" Width="88"
                                            ElementStyle="{StaticResource TextoCelula}"/>
                        <DataGridTextColumn Header="Operação" Binding="{Binding Operacao}" Width="*"
                                            ElementStyle="{StaticResource TextoCelula}"/>
                        <DataGridTextColumn Header="Registro" Binding="{Binding RegistroAfetado}" Width="80"
                                            ElementStyle="{StaticResource TextoCelula}"/>
                        <DataGridTextColumn Header="Valor anterior" Binding="{Binding ValorAnterior}" Width="105"
                                            ElementStyle="{StaticResource TextoCelula}"/>
                        <DataGridTextColumn Header="Novo valor" Binding="{Binding NovoValor}" Width="105"
                                            ElementStyle="{StaticResource TextoCelula}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ====================== TELA 5: REDEFINIR SENHA ====================== -->
            <Grid x:Name="gridSenha" Visibility="Collapsed">
                <Border Background="{StaticResource CorCartao}" CornerRadius="14" Padding="22,16" Width="360"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Redefinir senha" Style="{StaticResource Titulo}"/>
                        <TextBlock Text="Escolha o usuário e defina uma nova senha. A senha antiga nunca é exibida."
                                   Style="{StaticResource Subtitulo}"/>

                        <TextBlock Text="Usuário" Style="{StaticResource Rotulo}"/>
                        <ComboBox x:Name="cmbUsuarioSenha">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TextoEscolha}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="Nova senha (mínimo 8 caracteres)" Style="{StaticResource Rotulo}"/>
                        <PasswordBox x:Name="pwdNovaSenha" Style="{StaticResource CampoSenha}"/>

                        <TextBlock Text="Confirmação da nova senha" Style="{StaticResource Rotulo}"/>
                        <PasswordBox x:Name="pwdConfirmacaoSenha" Style="{StaticResource CampoSenha}"/>

                        <Button x:Name="btnRedefinirSenha" Content="Redefinir senha" Style="{StaticResource BotaoPrincipal}"
                                HorizontalAlignment="Left" Margin="0,16,0,0" Click="BtnRedefinirSenha_Click"/>
                        <TextBlock x:Name="txtMensagemSenha" Style="{StaticResource Mensagem}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ====================== TELA 6: SAIR (confirmação) ====================== -->
            <Grid x:Name="gridSair" Visibility="Collapsed">
                <Border Background="{StaticResource CorCartao}" CornerRadius="14" Padding="28,24" Width="320"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="&#xE7E8;" Style="{StaticResource Icone}" Foreground="White" FontSize="30"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Deseja realmente sair?" Foreground="White" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="Você voltará para a tela de login." Style="{StaticResource Subtitulo}"
                                   HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="btnSairSim" Content="Sim, sair" Style="{StaticResource BotaoPrincipal}"
                                    Width="110" Click="BtnSairSim_Click"/>
                            <Button x:Name="btnSairNao" Content="Cancelar" Width="110" Margin="8,0,0,0"
                                    Click="BtnSairNao_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
