<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sistema_de_Gerenciamento_de_Usuários"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="Sistema_de_Gerenciamento_de_Usuários.Dashboard"
        mc:Ignorable="d"
        Title="Dashboard" Height="446" Width="800" Background="#FF019288">

    <Window.Resources>
        <!-- ETIQUETA DE STATUS DO CARD -->
        <Style x:Key="EtiquetaStatus" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="#CFD8DC"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Ativo">
                    <Setter Property="Background" Value="#C8E6C9"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Bloqueado">
                    <Setter Property="Background" Value="#FFCDD2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- BOTOES DO CARD SO PARA ADMIN -->
        <Style x:Key="SoParaAdmin" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding PodeEditar}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SoSeBloqueado" TargetType="Button">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding EstaBloqueado}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ESTILOS DOS FORMULARIOS -->
        <Style x:Key="Titulo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="11,10,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>

        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CampoSenha" TargetType="PasswordBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Mensagem" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- ESTILOS DA TABELA DE AUDITORIA -->
        <Style x:Key="CabecalhoGrid" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style x:Key="CelulaGrid" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#55FFFFFF"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid HorizontalAlignment="Center" Height="411" VerticalAlignment="Center" Width="780" Background="#FF019288">

        <!-- ================= BARRA LATERAL ================= -->
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="411" VerticalAlignment="Center" Width="141">
            <DockPanel>
                <!-- Usuario logado (rodape) -->
                <Border DockPanel.Dock="Bottom" Background="#22FFFFFF" CornerRadius="8" Margin="5" Padding="5">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="36" Height="36">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="imagem_usuario_" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="nomeusuariotelainferior" Text="Usuário" Foreground="White"
                                   Width="75" Margin="6,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Botoes -->
                <StackPanel VerticalAlignment="Top" Margin="0,5,0,0">
                    <Button x:Name="listadeusuarios" Content="Usuários" Height="40" Width="129" Margin="5,0,0,10" Click="Button_Click_2"/>
                    <Button x:Name="cadastrousuario" Content="Cadastrar usuário" Height="40" Width="129" Margin="5,0,0,10" Click="cadastrousuario_Click"/>
                    <Button x:Name="auditoria" Content="Auditoria" Height="40" Width="129" Margin="5,0,0,10" Click="auditoria_Click"/>
                    <Button x:Name="redefinirsenha" Content="Redefinir senha" Height="40" Width="129" Margin="5,0,0,10" Click="Button_Click_3"/>
                    <Button x:Name="sair" Content="Sair" Height="40" Width="129" Margin="5,0,0,10" Click="sair_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= TELA: LISTA DE USUARIOS ================= -->
        <Grid x:Name="gridLista" HorizontalAlignment="Left" Height="411" Margin="154,0,0,0" VerticalAlignment="Center" Width="626">

            <!-- Busca -->
            <Border Background="#26FFFFFF" CornerRadius="6" HorizontalAlignment="Left" Height="33" Margin="11,10,0,0" VerticalAlignment="Top" Width="367">
                <TextBox x:Name="txtBusca" Background="Transparent" BorderThickness="0"
                         Foreground="White" CaretBrush="White" FontSize="13"
                         Padding="10,0" VerticalContentAlignment="Center"
                         TextChanged="AplicarFiltro"/>
            </Border>

            <!-- Filtros -->
            <ComboBox x:Name="cmbPerfil" HorizontalAlignment="Left" Height="33" Margin="394,10,0,0" VerticalAlignment="Top" Width="109" SelectionChanged="AplicarFiltro">
                <ComboBoxItem Content="Todos" IsSelected="True"/>
                <ComboBoxItem Content="Administrador"/>
                <ComboBoxItem Content="Comum"/>
            </ComboBox>
            <ComboBox x:Name="cmbStatus" HorizontalAlignment="Left" Height="33" Margin="517,10,0,0" VerticalAlignment="Top" Width="109" SelectionChanged="AplicarFiltro">
                <ComboBoxItem Content="Todos" IsSelected="True"/>
                <ComboBoxItem Content="Ativo"/>
                <ComboBoxItem Content="Inativo"/>
                <ComboBoxItem Content="Bloqueado"/>
            </ComboBox>

            <!-- Contador -->
            <TextBlock x:Name="txtContador" Foreground="White" FontSize="12" Margin="11,50,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>

            <!-- Cards -->
            <ScrollViewer Margin="11,72,0,45" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="listaCards">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="140" Margin="0,0,10,10" Padding="8" Background="#22FFFFFF" CornerRadius="10">
                                <StackPanel>
                                    <Ellipse Width="50" Height="50" Margin="0,0,0,6">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <TextBlock Text="{Binding Nome}" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Usuario}" Foreground="White" FontSize="12" Opacity="0.85" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Email}" Foreground="White" FontSize="11" Opacity="0.85" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>

                                    <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,6">
                                        <Border Background="#B2DFDB" CornerRadius="10" Padding="8,2" Margin="2">
                                            <TextBlock Text="{Binding Tipo}" FontSize="11" Foreground="#004D40"/>
                                        </Border>
                                        <Border Style="{StaticResource EtiquetaStatus}">
                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#263238"/>
                                        </Border>
                                    </WrapPanel>

                                    <TextBlock Text="{Binding UltimoLogin}" Foreground="White" FontSize="10" Opacity="0.8" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>

                                    <StackPanel Style="{StaticResource SoParaAdmin}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Editar" Width="58" Margin="2,0" Click="Editar_Click"/>
                                            <Button Content="Excluir" Width="58" Margin="2,0" Click="Excluir_Click"/>
                                        </StackPanel>
                                        <Button Content="Desbloquear" Width="120" Margin="0,6,0,0"
                                                Style="{StaticResource SoSeBloqueado}" Click="Desbloquear_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Paginas -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
                <Button x:Name="btnAnterior" Content="&lt;" Width="30" Height="28" Margin="3,0" Click="Anterior_Click"/>
                <StackPanel x:Name="painelPaginas" Orientation="Horizontal"/>
                <Button x:Name="btnProxima" Content="&gt;" Width="30" Height="28" Margin="3,0" Click="Proxima_Click"/>
            </StackPanel>
        </Grid>

        <!-- ================= TELA: CADASTRO DE USUARIO ================= -->
        <Grid x:Name="gridCadastro" Visibility="Collapsed" HorizontalAlignment="Left" Height="411" Margin="154,0,0,0" VerticalAlignment="Center" Width="626">
            <TextBlock Text="Cadastrar usuário" Style="{StaticResource Titulo}"/>

            <!-- Coluna esquerda -->
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Width="290" Margin="11,42,0,0">
                <TextBlock Text="Nome completo" Style="{StaticResource Rotulo}"/>
                <TextBox x:Name="txtNomeCad" Style="{StaticResource CampoTexto}"/>

                <TextBlock Text="Nome de usuário" Style="{StaticResource Rotulo}"/>
                <TextBox x:Name="txtUsuarioCad" Style="{StaticResource CampoTexto}"/>

                <TextBlock Text="E-mail" Style="{StaticResource Rotulo}"/>
                <TextBox x:Name="txtEmailCad" Style="{StaticResource CampoTexto}"/>

                <TextBlock Text="Senha" Style="{StaticResource Rotulo}"/>
                <PasswordBox x:Name="pwdSenhaCad" Style="{StaticResource CampoSenha}"/>

                <TextBlock Text="Confirmação da senha" Style="{StaticResource Rotulo}"/>
                <PasswordBox x:Name="pwdConfirmaCad" Style="{StaticResource CampoSenha}"/>
            </StackPanel>

            <!-- Coluna direita -->
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Width="290" Margin="320,42,0,0">
                <TextBlock Text="Tipo de usuário" Style="{StaticResource Rotulo}"/>
                <ComboBox x:Name="cmbTipoCad" Height="30" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Administrador"/>
                    <ComboBoxItem Content="Comum" IsSelected="True"/>
                </ComboBox>

                <TextBlock Text="Status" Style="{StaticResource Rotulo}"/>
                <ComboBox x:Name="cmbStatusCad" Height="30" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Ativo" IsSelected="True"/>
                    <ComboBoxItem Content="Inativo"/>
                </ComboBox>

                <TextBlock Text="Imagem de perfil" Style="{StaticResource Rotulo}"/>
                <ListBox x:Name="listaAvatares" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Width="36" Height="36" Margin="2">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="Cadastrar" Width="140" Height="32" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Cadastrar_Click"/>
                <TextBlock x:Name="txtMsgCadastro" Style="{StaticResource Mensagem}"/>
            </StackPanel>
        </Grid>

        <!-- ================= TELA: AUDITORIA ================= -->
        <Grid x:Name="gridAuditoria" Visibility="Collapsed" HorizontalAlignment="Left" Height="411" Margin="154,0,0,0" VerticalAlignment="Center" Width="626">
            <TextBlock Text="Auditoria" Style="{StaticResource Titulo}"/>

            <ComboBox x:Name="cmbCategoria" HorizontalAlignment="Left" VerticalAlignment="Top" Height="30" Width="130" Margin="481,10,0,0"
                      VerticalContentAlignment="Center" SelectionChanged="FiltrarAuditoria">
                <ComboBoxItem Content="Todos" IsSelected="True"/>
                <ComboBoxItem Content="Alteração"/>
                <ComboBoxItem Content="Autenticação"/>
            </ComboBox>

            <DataGrid x:Name="dgAuditoria" Margin="11,50,11,10"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0"
                      Background="Transparent" BorderThickness="0" Foreground="White"
                      RowBackground="#22FFFFFF" AlternatingRowBackground="#11FFFFFF"
                      ColumnHeaderStyle="{StaticResource CabecalhoGrid}"
                      CellStyle="{StaticResource CelulaGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data e hora" Binding="{Binding DataHora}" Width="105"/>
                    <DataGridTextColumn Header="Usuário" Binding="{Binding Responsavel}" Width="70"/>
                    <DataGridTextColumn Header="Operação" Binding="{Binding Operacao}" Width="*"/>
                    <DataGridTextColumn Header="Registro" Binding="{Binding Registro}" Width="70"/>
                    <DataGridTextColumn Header="Anterior" Binding="{Binding ValorAnterior}" Width="85"/>
                    <DataGridTextColumn Header="Novo valor" Binding="{Binding NovoValor}" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ================= TELA: REDEFINIR SENHA ================= -->
        <Grid x:Name="gridSenha" Visibility="Collapsed" HorizontalAlignment="Left" Height="411" Margin="154,0,0,0" VerticalAlignment="Center" Width="626">
            <TextBlock Text="Redefinir senha" Style="{StaticResource Titulo}"/>

            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Width="300" Margin="11,42,0,0">

                <!-- So admin: escolhe de quem e a senha -->
                <StackPanel x:Name="painelUsuarioAlvo">
                    <TextBlock Text="Usuário" Style="{StaticResource Rotulo}"/>
                    <ComboBox x:Name="cmbUsuarioAlvo" Height="30" DisplayMemberPath="Nome" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- So usuario comum: confirma a senha atual -->
                <StackPanel x:Name="painelSenhaAtual" Visibility="Collapsed">
                    <TextBlock Text="Senha atual" Style="{StaticResource Rotulo}"/>
                    <PasswordBox x:Name="pwdAtual" Style="{StaticResource CampoSenha}"/>
                </StackPanel>

                <TextBlock Text="Nova senha" Style="{StaticResource Rotulo}"/>
                <PasswordBox x:Name="pwdNova" Style="{StaticResource CampoSenha}"/>

                <TextBlock Text="Confirmação da nova senha" Style="{StaticResource Rotulo}"/>
                <PasswordBox x:Name="pwdConfirmaNova" Style="{StaticResource CampoSenha}"/>

                <Button Content="Redefinir senha" Width="140" Height="32" HorizontalAlignment="Left" Margin="0,12,0,0" Click="RedefinirSenha_Click"/>
                <TextBlock x:Name="txtMsgSenha" Style="{StaticResource Mensagem}"/>
            </StackPanel>
        </Grid>

        <!-- ================= TELA: SAIR ================= -->
        <Grid x:Name="gridSair" Visibility="Collapsed" HorizontalAlignment="Left" Height="411" Margin="154,0,0,0" VerticalAlignment="Center" Width="626">
            <Border Background="#22FFFFFF" CornerRadius="10" Padding="24" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Deseja realmente sair?" Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Sim" Width="90" Height="32" Margin="4,0" Click="SairSim_Click"/>
                        <Button Content="Cancelar" Width="90" Height="32" Margin="4,0" Click="SairNao_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>