<Window x:Class="Sistema_de_Gerenciamento_de_Usuários.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Gerenciamento de Usuários" Width="800" Height="600"
        Background="#FF019288" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Loaded="Janela_Loaded">

    <!-- ===================================================================
         MAINWINDOW (USUÁRIO COMUM)
         Mesmo visual do Dashboard, mas:
           - os cards são SÓ PARA VER (sem Editar / Excluir / Desbloquear);
           - "Meu perfil" edita só nome, e-mail e avatar do próprio usuário;
           - "Redefinir senha" troca a própria senha (pede a senha atual).
         Telas: gridUsuarios, gridPerfil, gridSenha, gridSair
         (só uma Visible, as outras Collapsed - método MostrarTela).
         =================================================================== -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Molde do CARD (somente leitura: nenhum botão) -->
            <DataTemplate x:Key="CardUsuarioLeitura">
                <Border Style="{StaticResource Cartao}">
                    <StackPanel VerticalAlignment="Center">
                        <Ellipse Width="52" Height="52">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding ImagemAvatar}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>

                        <TextBlock Text="{Binding NomeCompleto}" Foreground="White" FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding Arroba}" Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Email}" Foreground="White" FontSize="12" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Border Style="{StaticResource EtiquetaTipo}">
                                <TextBlock Text="{Binding Tipo}" FontSize="11"/>
                            </Border>
                            <Border Style="{StaticResource EtiquetaStatus}">
                                <TextBlock Text="{Binding Status}" FontSize="11"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding TextoUltimoLogin}" Foreground="White" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Width="780" Height="565" HorizontalAlignment="Center" VerticalAlignment="Center">

        <!-- ============================ BARRA LATERAL ============================ -->
        <Border Width="141" HorizontalAlignment="Left" BorderBrush="{StaticResource CorDivisoria}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,8,0,8">

                <!-- Bloco do usuário logado (embaixo). Clicar abre "Meu perfil". -->
                <Button x:Name="btnBlocoUsuario" DockPanel.Dock="Bottom" Style="{StaticResource BlocoUsuario}"
                        Width="129" ToolTip="Abrir meu perfil" Click="BtnBlocoUsuario_Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="elpAvatarLogado" Width="36" Height="36" Fill="#FF004D40"/>
                            <StackPanel Width="70" Margin="7,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="txtNomeLogado" Foreground="White" FontSize="12" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="txtTipoLogado" Foreground="White" FontSize="11" Opacity="0.85"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="txtArrobaLogado" Foreground="White" FontSize="10" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="txtNivelLogado" Foreground="White" FontSize="10" Opacity="0.85"/>
                        <TextBlock x:Name="txtUltimoLoginLogado" Foreground="White" FontSize="10" Opacity="0.85"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>

                <!-- Botões do menu -->
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                    <Button x:Name="btnMenuUsuarios" Content="Usuários" Style="{StaticResource BotaoMenu}" Click="BtnMenuUsuarios_Click"/>
                    <Button x:Name="btnMenuPerfil" Content="Meu perfil" Style="{StaticResource BotaoMenu}" Click="BtnMenuPerfil_Click"/>
                    <Button x:Name="btnMenuSenha" Content="Redefinir senha" Style="{StaticResource BotaoMenu}" Click="BtnMenuSenha_Click"/>
                    <Button x:Name="btnMenuSair" Content="Sair" Style="{StaticResource BotaoMenu}" Click="BtnMenuSair_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================ ÁREA DE CONTEÚDO ============================ -->
        <Grid Width="626" Margin="154,0,0,0" HorizontalAlignment="Left">

            <!-- ====================== TELA 1: USUÁRIOS (somente leitura) ====================== -->
            <Grid x:Name="gridUsuarios">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="128"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="133"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox x:Name="txtBusca" Style="{StaticResource CampoTexto}" Height="38" Padding="34,0,10,0"
                                 TextChanged="TxtBusca_TextChanged"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icone}" Foreground="White" FontSize="14"
                                   Margin="13,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                        <TextBlock x:Name="txtDicaBusca" Text="Buscar por nome, usuário ou e-mail" Foreground="White"
                                   Opacity="0.85" FontSize="13" Margin="37,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <ComboBox x:Name="cmbPerfil" Grid.Column="2" Height="38" Tag="Perfil: " SelectedIndex="0"
                              SelectionChanged="CmbFiltro_SelectionChanged">
                        <ComboBoxItem Content="Todos"/>
                        <ComboBoxItem Content="Administrador"/>
                        <ComboBoxItem Content="Comum"/>
                    </ComboBox>

                    <ComboBox x:Name="cmbStatus" Grid.Column="4" Height="38" Tag="Status: " SelectedIndex="0"
                              SelectionChanged="CmbFiltro_SelectionChanged">
                        <ComboBoxItem Content="Todos"/>
                        <ComboBoxItem Content="Ativo"/>
                        <ComboBoxItem Content="Inativo"/>
                        <ComboBoxItem Content="Bloqueado"/>
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,6">
                    <TextBlock x:Name="txtContador" Text="0 usuários" Foreground="White" FontSize="12" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="txtAvisoLista" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"
                               TextTrimming="CharacterEllipsis" MaxWidth="480"/>
                </Grid>

                <ItemsControl x:Name="icCards" Grid.Row="2" Margin="-5" ItemTemplate="{StaticResource CardUsuarioLeitura}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock x:Name="txtSemResultados" Grid.Row="2" Text="Nenhum usuário encontrado."
                           Foreground="White" FontSize="14" Opacity="0.85"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>

                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,8">
                    <Button x:Name="btnAnterior" Content="&lt;" Style="{StaticResource BotaoPagina}" Click="BtnAnterior_Click"/>
                    <StackPanel x:Name="pnlPaginas" Orientation="Horizontal"/>
                    <Button x:Name="btnProxima" Content="&gt;" Style="{StaticResource BotaoPagina}" Click="BtnProxima_Click"/>
                </StackPanel>
            </Grid>

            <!-- ====================== TELA 2: MEU PERFIL ====================== -->
            <Grid x:Name="gridPerfil" Visibility="Collapsed">
                <Border Background="{StaticResource CorCartao}" CornerRadius="14" Padding="22,16" Margin="0,8,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="3">
                            <TextBlock Text="Meu perfil" Style="{StaticResource Titulo}"/>
                            <TextBlock x:Name="txtInfoPerfil" Style="{StaticResource Subtitulo}"/>
                        </StackPanel>

                        <!-- esquerda: o que PODE mudar (nome e e-mail) e o que só aparece -->
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="Nome completo" Style="{StaticResource Rotulo}"/>
                            <TextBox x:Name="txtNomePerfil" Style="{StaticResource CampoTexto}"/>

                            <TextBlock Text="E-mail" Style="{StaticResource Rotulo}"/>
                            <TextBox x:Name="txtEmailPerfil" Style="{StaticResource CampoTexto}"/>

                            <!-- somente leitura: o usuário comum NÃO pode mudar estes -->
                            <TextBlock Text="Nome de usuário (não pode ser alterado)" Style="{StaticResource Rotulo}"/>
                            <TextBox x:Name="txtUsuarioPerfil" Style="{StaticResource CampoTexto}" IsReadOnly="True" Focusable="False"/>

                            <TextBlock Text="Tipo e status (só o administrador altera)" Style="{StaticResource Rotulo}"/>
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="brdTipoPerfil" Style="{StaticResource EtiquetaTipo}" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Tipo}" FontSize="12"/>
                                </Border>
                                <Border x:Name="brdStatusPerfil" Style="{StaticResource EtiquetaStatus}">
                                    <TextBlock Text="{Binding Status}" FontSize="12"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- direita: avatar e botão -->
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="Imagem de perfil" Style="{StaticResource Rotulo}"/>
                            <ListBox x:Name="lstAvataresPerfil" Style="{StaticResource ListaAvatares}"/>

                            <Button x:Name="btnSalvarPerfil" Content="Salvar alterações" Style="{StaticResource BotaoPrincipal}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" Click="BtnSalvarPerfil_Click"/>
                            <TextBlock x:Name="txtMensagemPerfil" Style="{StaticResource Mensagem}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ====================== TELA 3: REDEFINIR (A PRÓPRIA) SENHA ====================== -->
            <Grid x:Name="gridSenha" Visibility="Collapsed">
                <Border Background="{StaticResource CorCartao}" CornerRadius="14" Padding="22,16" Width="360"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Redefinir senha" Style="{StaticResource Titulo}"/>
                        <TextBlock Text="Para trocar a sua senha, confirme primeiro a senha atual."
                                   Style="{StaticResource Subtitulo}"/>

                        <TextBlock Text="Senha atual" Style="{StaticResource Rotulo}"/>
                        <PasswordBox x:Name="pwdSenhaAtual" Style="{StaticResource CampoSenha}"/>

                        <TextBlock Text="Nova senha (mínimo 8 caracteres)" Style="{StaticResource Rotulo}"/>
                        <PasswordBox x:Name="pwdNovaSenha" Style="{StaticResource CampoSenha}"/>

                        <TextBlock Text="Confirmação da nova senha" Style="{StaticResource Rotulo}"/>
                        <PasswordBox x:Name="pwdConfirmacaoSenha" Style="{StaticResource CampoSenha}"/>

                        <Button x:Name="btnAlterarSenha" Content="Alterar minha senha" Style="{StaticResource BotaoPrincipal}"
                                HorizontalAlignment="Left" Margin="0,16,0,0" Click="BtnAlterarSenha_Click"/>
                        <TextBlock x:Name="txtMensagemSenha" Style="{StaticResource Mensagem}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ====================== TELA 4: SAIR (confirmação) ====================== -->
            <Grid x:Name="gridSair" Visibility="Collapsed">
                <Border Background="{StaticResource CorCartao}" CornerRadius="14" Padding="28,24" Width="320"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="&#xE7E8;" Style="{StaticResource Icone}" Foreground="White" FontSize="30"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Deseja realmente sair?" Foreground="White" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Text="Você voltará para a tela de login." Style="{StaticResource Subtitulo}"
                                   HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="btnSairSim" Content="Sim, sair" Style="{StaticResource BotaoPrincipal}"
                                    Width="110" Click="BtnSairSim_Click"/>
                            <Button x:Name="btnSairNao" Content="Cancelar" Width="110" Margin="8,0,0,0"
                                    Click="BtnSairNao_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
