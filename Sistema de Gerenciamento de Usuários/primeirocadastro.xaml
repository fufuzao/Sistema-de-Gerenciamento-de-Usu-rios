<Window x:Class="Sistema_de_Gerenciamento_de_Usuários.primeirocadastro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Primeiro cadastro" Width="800" Height="600"
        Background="#FF019288" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Loaded="Janela_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Width="780" Height="565" HorizontalAlignment="Center" VerticalAlignment="Center">

        <Border Background="{StaticResource CorCartao}" CornerRadius="14" Padding="28,22" Width="640"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Cabeçalho -->
                <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,6">
                    <TextBlock Text="Primeiro cadastro" Style="{StaticResource Titulo}"/>
                    <TextBlock Style="{StaticResource Subtitulo}"
                               Text="O sistema ainda não tem usuários. Crie o primeiro: ele será o ADMINISTRADOR (ativo) e poderá cadastrar os próximos."/>
                </StackPanel>

                <!-- Coluna da esquerda: dados -->
                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="Nome completo" Style="{StaticResource Rotulo}"/>
                    <TextBox x:Name="txtNome" Style="{StaticResource CampoTexto}"/>

                    <TextBlock Text="Nome de usuário" Style="{StaticResource Rotulo}"/>
                    <TextBox x:Name="txtUsuario" Style="{StaticResource CampoTexto}"/>

                    <TextBlock Text="E-mail" Style="{StaticResource Rotulo}"/>
                    <TextBox x:Name="txtEmail" Style="{StaticResource CampoTexto}"/>

                    <TextBlock Text="Senha (mínimo 8 caracteres)" Style="{StaticResource Rotulo}"/>
                    <PasswordBox x:Name="pwdSenha" Style="{StaticResource CampoSenha}"/>

                    <TextBlock Text="Confirmação da senha" Style="{StaticResource Rotulo}"/>
                    <PasswordBox x:Name="pwdConfirmacao" Style="{StaticResource CampoSenha}"/>
                </StackPanel>

                <!-- Coluna da direita: avatar, tipo fixo e botão -->
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="Imagem de perfil" Style="{StaticResource Rotulo}"/>
                    <ListBox x:Name="lstAvatares" Style="{StaticResource ListaAvatares}"/>

                    <TextBlock Text="Tipo e status" Style="{StaticResource Rotulo}"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#FFFFE082" CornerRadius="10" Padding="10,2" Margin="0,0,6,0">
                            <TextBlock Text="Administrador" Foreground="#FF5D4037" FontSize="12"/>
                        </Border>
                        <Border Background="#FFC8E6C9" CornerRadius="10" Padding="10,2">
                            <TextBlock Text="Ativo" Foreground="#FF1B5E20" FontSize="12"/>
                        </Border>
                    </StackPanel>

                    <Button x:Name="btnCriar" Content="Criar administrador" Style="{StaticResource BotaoPrincipal}"
                            IsDefault="True" HorizontalAlignment="Left" Margin="0,24,0,0" Click="BtnCriar_Click"/>

                    <TextBlock x:Name="txtMensagem" Style="{StaticResource Mensagem}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
