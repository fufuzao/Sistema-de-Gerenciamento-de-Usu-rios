<Window x:Class="Sistema_de_Gerenciamento_de_Usuários.primeirocadastro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Primeiro cadastro" Height="446" Width="700"
        Background="#FF019288" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20,10,20,10">
        <TextBlock Text="Primeiro cadastro" Style="{StaticResource Titulo}" Margin="0,0,0,0"/>
        <TextBlock Text="Crie o primeiro usuário do sistema. Ele será o administrador e poderá cadastrar os próximos."
                   Foreground="White" FontSize="12" TextWrapping="Wrap" Margin="0,30,0,0" VerticalAlignment="Top"/>

        <!-- Coluna esquerda -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Width="300" Margin="0,55,0,0">
            <TextBlock Text="Nome completo" Style="{StaticResource Rotulo}"/>
            <TextBox x:Name="txtNome" Style="{StaticResource CampoTexto}"/>

            <TextBlock Text="Nome de usuário" Style="{StaticResource Rotulo}"/>
            <TextBox x:Name="txtUsuario" Style="{StaticResource CampoTexto}"/>

            <TextBlock Text="E-mail" Style="{StaticResource Rotulo}"/>
            <TextBox x:Name="txtEmail" Style="{StaticResource CampoTexto}"/>

            <TextBlock Text="Senha" Style="{StaticResource Rotulo}"/>
            <PasswordBox x:Name="pwdSenha" Style="{StaticResource CampoSenha}"/>

            <TextBlock Text="Confirmação da senha" Style="{StaticResource Rotulo}"/>
            <PasswordBox x:Name="pwdConfirma" Style="{StaticResource CampoSenha}"/>
        </StackPanel>

        <!-- Coluna direita -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Width="300" Margin="0,55,0,0">
            <TextBlock Text="Imagem de perfil" Style="{StaticResource Rotulo}"/>
            <ListBox x:Name="listaAvatares" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Ellipse Width="40" Height="40" Margin="3">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Imagem}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Content="Criar administrador" Width="160" Height="34" HorizontalAlignment="Left" Margin="0,20,0,0" Click="Criar_Click"/>
            <TextBlock x:Name="txtMsg" Style="{StaticResource Mensagem}"/>
        </StackPanel>
    </Grid>
</Window>
